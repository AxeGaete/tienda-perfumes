# Copiá este archivo como backend/.env (o cargá estas variables en el panel de Render).
# NUNCA subas el .env real al repositorio.

NODE_ENV=production
PORT=3000

# --- Admin ---
# Obligatoria. Mínimo 12 caracteres; recomendado 24+. Generá una con:
#   node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
ADMIN_SECRET_KEY=
# Opcional. Si no se define, se genera al iniciar (las sesiones se cierran en cada reinicio).
SESSION_SECRET=

# --- Base de datos ---
DB_HOST=
DB_PORT=3306
DB_USER=
DB_PASSWORD=
DB_NAME=
# Alternativa: una sola URL en lugar de las variables DB_* de arriba
# DATABASE_URL=
# Solo si tu proveedor usa un certificado propio y falla la verificación:
# DB_SSL_REJECT_UNAUTHORIZED=false
# DB_SSL_CA=

# --- Cloudinary ---
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# --- CORS (dejar vacío si el frontend se sirve desde este mismo servidor) ---
ALLOWED_ORIGINS=

# --- Diagnóstico ---
# true = la Content-Security-Policy solo reporta violaciones en la consola, sin bloquear. Usar al probar un despliegue nuevo.
# CSP_REPORT_ONLY=false
